{
  "name": "jev-bot-trading",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de trading de cripto: decisiones tipadas con Jev (TypeSafe AI), ejecucion en Kraken, con paper trading y backtesting.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "tsx src/cli.ts doctor",
    "once": "tsx src/cli.ts once",
    "run": "tsx src/cli.ts run",
    "status": "tsx src/cli.ts status",
    "backtest": "tsx src/cli.ts backtest",
    "flat": "tsx src/cli.ts flat"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

# ==========================================================================
#  jev-bot-trading  ·  configuracion
#  Copia este archivo a .env y editalo.  El .env NUNCA va al repositorio.
# ==========================================================================

# --- MODO DE EJECUCION ----------------------------------------------------
# paper  : simulador local con precios reales. No toca el exchange. EMPEZA ACA.
# dryrun : firma y manda la orden a Kraken con validate=true. Kraken la valida
#          (saldo, minimos, decimales) y NO la ejecuta. Sirve para comprobar
#          que tus credenciales y tus tamanos de orden son correctos.
# live   : ordenes reales con plata real.
MODE=paper

# --- MERCADO --------------------------------------------------------------
# XBTUSD = Bitcoin/dolar en notacion Kraken (ellos le dicen XBT a BTC).
# Alternativas razonables: ETHUSD, SOLUSD.
PAIR=XBTUSD
# Minutos por vela. El default es 60 por el costo: con una vuelta completa
# costando ~0.80%, los movimientos de una vela de 15m rara vez lo cubren y el
# bot terminaria operando mucho para entregarle el resultado al exchange.
CANDLE_INTERVAL_MIN=60
LOOP_INTERVAL_SEC=300

# --- CAPITAL --------------------------------------------------------------
PAPER_STARTING_CASH=1000
# Porcion del capital que puede entrar en una sola posicion.
MAX_POSITION_PCT=0.25
MIN_ORDER_USD=10

# --- RIESGO ---------------------------------------------------------------
# Cuanto del capital total se arriesga en UNA operacion. De la relacion entre
# este numero y HARD_STOP_PCT sale el tamano de la posicion.
RISK_PER_TRADE_PCT=0.01
# Distancia maxima del stop respecto del precio de entrada.
HARD_STOP_PCT=0.05
STOP_ATR_MULT=2
TAKE_PROFIT_ATR_MULT=3
TRAILING_STOP_PCT=0.03
# Perdida diaria que frena las entradas por el resto del dia.
DAILY_LOSS_LIMIT_PCT=0.03
# Caida desde el maximo que apaga el bot por completo hasta que lo reactives.
MAX_DRAWDOWN_PCT=0.15
MAX_TRADES_PER_DAY=6
COOLDOWN_MIN=30
MAX_HOLDING_HOURS=72
MAX_SPREAD_BPS=20
# Cuantas veces el objetivo de la operacion tiene que cubrir su costo de ida y
# vuelta para que valga la pena entrar. En 1 el bot entraria en operaciones que
# apenas empatan: el objetivo se alcanza solo a veces, el costo se paga siempre.
MIN_EDGE_MULTIPLE=1.5

# --- UMBRALES SOBRE LA SALIDA DE JEV --------------------------------------
# Jev devuelve probabilidades; estos numeros deciden cuando esas probabilidades
# alcanzan para mover plata. Subirlos = menos operaciones y mas selectivas.
MIN_BUY_PROBABILITY=0.6
MIN_CONFIDENCE=0.55
MIN_CONVICTION=2
MAX_RISK_PROBABILITY=0.5
EXIT_PROBABILITY=0.65

# Interruptor general de entradas. En false el bot solo cierra lo que tenga
# abierto y no abre nada nuevo. Util para desactivarlo sin matar el proceso.
ALLOW_ENTRIES=true

# --- CREDENCIALES ---------------------------------------------------------
# Jev / TypeSafe AI  ->  https://typesafe.ai
# Sin esta clave el bot funciona igual, con el cerebro heuristico de reserva.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Kraken  ->  Settings > API > Create API key
# Permisos a habilitar: Query Funds, Query Open/Closed Orders, Create & Modify
# Orders, Cancel/Close Orders.
# Permiso a DEJAR APAGADO: Withdraw Funds.  Sin el, una filtracion de la clave
# no permite sacar un peso de la cuenta.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- OPERACION ------------------------------------------------------------
DATA_DIR=./data
LOG_LEVEL=info
# Comision por operacion. 0.004 = 0.40%, el arancel TAKER del tramo base de
# Kraken (menos de USD 10.000 de volumen en 30 dias). El bot usa ordenes a
# mercado, que siempre son taker. Revisa tu arancel real en Kraken:
# Settings > Fee schedule, y bajalo si tu volumen te movio de tramo.
FEE_RATE=0.004
PAPER_SLIPPAGE_BPS=5

# ==========================================================================
#  PERFIL DE DEMO  ·  paper trading, saldo virtual, plata ficticia
#
#  PLANTILLA. Copiala antes de usarla:
#
#      cp .env.demo.example .env.demo
#      npm run demo
#
#  El archivo .env.demo esta en .gitignore: tu clave nunca llega al repo.
#  NO pongas credenciales en ESTE archivo, que si se versiona.
# ==========================================================================
#
#  QUE PRUEBA ESTO Y QUE NO
#
#  SI prueba:  que el bot corre, que Jev responde, que los indicadores se
#              calculan, que las ordenes se ejecutan, que los stops saltan,
#              que el estado sobrevive un reinicio. O sea: la maquinaria.
#
#  NO prueba:  si la estrategia gana plata. Un dia son ~24 velas de 1 hora.
#              Eso no alcanza ni para una muestra. Para evaluar la estrategia
#              esta el backtest, que en dos minutos te da 180 dias.
#
#  Respecto del perfil normal, aca estan MAS FLOJOS los umbrales de senal
#  (para que veas operaciones en un solo dia) pero la matematica de costos
#  queda INTACTA: las comisiones son las reales de Kraken. Las operaciones
#  van a ser de menor calidad que en el perfil normal. Es a proposito.
# ==========================================================================

MODE=paper

# --- Mercado --------------------------------------------------------------
PAIR=XBTUSD
# Se mantienen las velas de 1h: con 15m el costo de operar no se cubre nunca
# y no verias ni una operacion.
CANDLE_INTERVAL_MIN=60
# Ciclo cada 2 minutos: mas lineas en el log para ver que esta vivo.
LOOP_INTERVAL_SEC=120

# --- Capital virtual ------------------------------------------------------
PAPER_STARTING_CASH=1000
MAX_POSITION_PCT=0.25
MIN_ORDER_USD=10

# --- Frenos aflojados para la prueba de un dia ---------------------------
# Pediste sacar el tope de 6 operaciones: aca esta en 50, que en la practica
# es ilimitado para un dia. En paper no hay riesgo real.
# OJO: en el perfil de plata real NO toques esto. El tope existe porque cada
# vuelta cuesta 0.80% y un bot sin freno se funde en comisiones.
MAX_TRADES_PER_DAY=50
COOLDOWN_MIN=10
DAILY_LOSS_LIMIT_PCT=0.10
MAX_DRAWDOWN_PCT=0.30

# --- Riesgo: se mantiene igual que en real --------------------------------
RISK_PER_TRADE_PCT=0.01
HARD_STOP_PCT=0.05
STOP_ATR_MULT=2
TAKE_PROFIT_ATR_MULT=3
TRAILING_STOP_PCT=0.03
MAX_HOLDING_HOURS=72
MAX_SPREAD_BPS=30

# --- Umbrales de senal: aflojados para ver actividad ----------------------
# En el perfil normal son 0.6 / 0.55 / 2 / 0.5. Bajarlos hace que el bot
# opere mas seguido y peor. Sirve para ver el mecanismo, no para decidir.
MIN_BUY_PROBABILITY=0.45
MIN_CONFIDENCE=0.40
MIN_CONVICTION=1
MAX_RISK_PROBABILITY=0.70
EXIT_PROBABILITY=0.60
# Sigue por encima de 1: no vamos a simular operaciones que pierden por
# definicion. Si el objetivo no cubre el costo, el bot no entra. Punto.
MIN_EDGE_MULTIPLE=1.2

ALLOW_ENTRIES=true

# --- Credenciales ---------------------------------------------------------
# Solo hace falta esta. Sin ella el bot igual corre, con el cerebro heuristico.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# NO hacen falta claves de Kraken: en paper no se toca el exchange.
# Los precios salen de la API publica, que no pide credenciales.

# --- Operacion ------------------------------------------------------------
# Directorio separado para que la demo no pise el estado del perfil real.
DATA_DIR=./data/demo
LOG_LEVEL=info
# Comisiones REALES de Kraken. No las bajamos: si las bajaramos, el resultado
# de la demo seria una fantasia.
FEE_RATE=0.004
PAPER_SLIPPAGE_BPS=5
